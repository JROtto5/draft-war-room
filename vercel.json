{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/(fonts/.*|icon-.*|.*\\.woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/feeds/nfl/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/feeds/nfl/injuries",
      "destination": "https://site.api.espn.com/apis/site/v2/sports/football/nfl/injuries"
    },
    {
      "source": "/feeds/nfl/scoreboard",
      "destination": "https://site.api.espn.com/apis/site/v2/sports/football/nfl/scoreboard"
    },
    {
      "source": "/draft",
      "destination": "/"
    },
    {
      "source": "/season",
      "destination": "/"
    }
  ],
  "functions": {
    "api/campaign.js": {
      "maxDuration": 60
    },
    "api/season-scan.js": {
      "maxDuration": 60
    },
    "api/edge-refresh.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/season-scan",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/edge-refresh",
      "schedule": "2-59/5 * * * *"
    }
  ]
}
